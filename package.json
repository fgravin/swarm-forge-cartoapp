{
  "name": "carto-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:property": "vitest run --config vitest.property.config.ts --passWithNoTests",
    "acceptance": "tsx acceptance/run.ts",
    "acceptance:generate": "tsx acceptance/generate.ts",
    "acceptance:mutate": "tsx acceptance/mutate.ts",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
